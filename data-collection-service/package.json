{
  "name": "quotation-data-collection-service",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env cli.mjs serve",
    "demo": "node cli.mjs serve --demo",
    "cli": "node --env-file-if-exists=.env cli.mjs",
    "worker:doctor": "node --env-file-if-exists=.env cli.mjs worker-doctor",
    "browser:install": "playwright-core install chromium",
    "mcp": "node --env-file-if-exists=.env mcp-server.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "playwright-core": "1.65.1",
    "zod": "4.6.7"
  },
  "devDependencies": { "@modelcontextprotocol/client": "2.4.0" }
}
