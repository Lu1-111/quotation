{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "protocolVersion": {
      "type": "string",
      "const": "zhihu-knowledge-profile/v1"
    },
    "module": {
      "type": "string",
      "const": "data-collection-service"
    },
    "kind": {
      "type": "string",
      "const": "knowledge_profile_page"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "snapshotId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "syncedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "policyVersion": {
      "type": "string"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "settings": {
          "type": "object",
          "properties": {
            "history": {
              "type": "boolean"
            },
            "likes": {
              "type": "boolean"
            },
            "collections": {
              "type": "boolean"
            },
            "knowledgeFilter": {
              "type": "boolean"
            },
            "fetchFullText": {
              "default": false,
              "type": "boolean"
            },
            "aiReview": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "history",
            "likes",
            "collections",
            "knowledgeFilter",
            "fetchFullText",
            "aiReview"
          ],
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "properties": {
            "history": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "likes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "collections": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "history",
            "likes",
            "collections"
          ],
          "additionalProperties": false
        },
        "excludedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "knowledgeFilterApplied": {
          "type": "boolean"
        },
        "modelAnalysisApplied": {
          "type": "boolean",
          "const": false
        },
        "historyScope": {
          "type": "string",
          "const": "latest_50_qualified"
        },
        "completeHistory": {
          "type": "boolean",
          "const": false
        },
        "fullTextGuaranteed": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "settings",
        "counts",
        "excludedCount",
        "knowledgeFilterApplied",
        "modelAnalysisApplied",
        "historyScope",
        "completeHistory",
        "fullTextGuaranteed"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "returned": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextOffset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "offset",
        "limit",
        "total",
        "returned",
        "hasMore",
        "nextOffset"
      ],
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "contentId": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "summaryTruncated": {
            "type": "boolean"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "history",
                "likes",
                "collections"
              ]
            }
          },
          "signals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "history",
                    "likes",
                    "collections"
                  ]
                },
                "time": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "time"
              ],
              "additionalProperties": false
            }
          },
          "voteCount": {
            "type": [
              "number",
              "null"
            ]
          },
          "commentCount": {
            "type": [
              "number",
              "null"
            ]
          },
          "metricsMissing": {
            "type": "boolean"
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "ruleDecision": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "keep",
                  "exclude",
                  "review"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bodyStatus": {
            "type": "string"
          },
          "fullTextAvailable": {
            "type": "boolean"
          },
          "bodyText": {
            "type": "string"
          },
          "bodyChars": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "contentTrust": {
            "type": "string",
            "const": "external_untrusted"
          }
        },
        "required": [
          "contentId",
          "contentType",
          "title",
          "summary",
          "summaryTruncated",
          "url",
          "author",
          "topics",
          "kinds",
          "signals",
          "voteCount",
          "commentCount",
          "metricsMissing",
          "weight",
          "ruleDecision",
          "domains",
          "tags",
          "bodyStatus",
          "fullTextAvailable",
          "contentTrust"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "protocolVersion",
    "module",
    "kind",
    "userId",
    "snapshotId",
    "syncedAt",
    "policyVersion",
    "coverage",
    "page",
    "records"
  ],
  "additionalProperties": false
}
