# 服务监听地址与端口（本机默认 127.0.0.1:3300；Docker 容器内默认 0.0.0.0:3300）
STAR_ATLAS_HOST=127.0.0.1
STAR_ATLAS_PORT=3300

# OpenAI 兼容大模型配置（可选；也可启动后直接在工作台「大模型设置」界面填写）
AGENT_BASE_URL=https://api.deepseek.com/v1
AGENT_MODEL=deepseek-chat
AGENT_API_KEY=

# 可选：知乎官方 OAuth 授权登录凭据（不填时仍可直接使用工作台页面内知乎扫码登录）
APP_ORIGIN=http://127.0.0.1:3000
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_ACCESS_SECRET=

# 可选：采集浏览器通道（auto / msedge / chrome / chromium；Docker 容器内固定为 chromium）
COLLECTOR_BROWSER=auto
