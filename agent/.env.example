# 智能体模块环境变量模板：只放变量名与无敏感内容的默认值。
# 真实值写入本地 .env（已被 .gitignore 忽略），不要提交密钥与令牌。

# OpenAI 兼容接口地址与模型名，例如本地 Ollama：http://127.0.0.1:11434/v1
AGENT_BASE_URL=
AGENT_MODEL=
# 本地模型服务可留空
AGENT_API_KEY=

# 最大步数（1 到 20）与超时（毫秒）
AGENT_MAX_STEPS=8
AGENT_TOTAL_TIMEOUT_MS=600000
AGENT_STEP_TIMEOUT_MS=120000

# 只有设为 true 才启用个人浏览数据工具；个人数据会发送给上面配置的模型服务
AGENT_ALLOW_PERSONAL_DATA=false

# 搜索与采集模块目录，默认相对 agent/ 解析
# AGENT_SEARCH_DIR=../information-search
# AGENT_COLLECTION_DIR=../data-collection-service

# 透传给信息搜索子进程（按知乎搜索 Skill 官方文档配置）
ZHIHU_ACCESS_SECRET=
# ZHIHU_OPENAPI_BASE_URL=https://developer.zhihu.com
# ZHIHU_ZHIHU_SEARCH_URL=
# DATA_FILE=

# 透传给采集子进程。
# DATA_SERVICE_AGENT_TOKEN 必须是用户在采集界面「Agent 交付」创建的 agt_ 只读凭证，
# 它只能读取已保存的数据，无法登录、改设置或发起同步；usr_ 用户令牌不被该入口接受。
DATA_SERVICE_URL=http://127.0.0.1:3005
DATA_SERVICE_AGENT_TOKEN=
