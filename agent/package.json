{
  "name": "quotation-agent",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "cli": "node --env-file-if-exists=.env cli.mjs",
    "doctor": "node --env-file-if-exists=.env cli.mjs doctor",
    "web": "node --env-file-if-exists=.env web.mjs",
    "serve": "node --env-file-if-exists=.env serve-cli.mjs",
    "serve:demo": "node --env-file-if-exists=.env serve-cli.mjs --demo",
    "serve:demo:web": "node --env-file-if-exists=.env demo-web-host.mjs",
    "serve:public:web": "node --env-file-if-exists=.env public-web-host.mjs",
    "replay:12turns": "node scripts/replay-twelve-turns.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.103",
    "@ai-sdk/openai-compatible": "3.0.94",
    "ai": "7.0.179",
    "zod": "4.6.7"
  }
}
